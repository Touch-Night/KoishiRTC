{
  "formatVersion": 1,
  "platform": "feishu",
  "os": "darwin",
  "calibrated": false,
  "label": "飞书会议语音",
  "notes": [
    "Calibration required: these are explicit starter workflows, not a declaration that a particular client build was tested.",
    "Preflight opens settings, reads the account and both audio device selections, and closes settings before call control. Edit these settings selectors to the actual accessibility tree; no audio setting is changed automatically.",
    "Exact target identity must be exposed. Do not substitute a non-unique contact nickname for an account ID; inspect the contact detail or meeting ID view and scope selectors appropriately.",
    "Client settings may expose names in title, description or value depending on platform. The inspector reports all three.",
    "While connected, account and routes are bound to the previously checked process/configuration. Manual changes to hidden settings cannot be detected continuously.",
    "Join button before opening the dialog and final join button are scoped to different windows. Calibrate these exact window titles; meeting IDs may be formatted with spaces by the client and must match its displayed form."
  ],
  "identity": {
    "role": "AXStaticText",
    "name": "{self}"
  },
  "target": {
    "role": "AXStaticText",
    "name": "{target}"
  },
  "audioInput": {
    "role": "AXPopUpButton",
    "name": "{input}"
  },
  "audioOutput": {
    "role": "AXPopUpButton",
    "name": "{output}"
  },
  "states": {
    "idle": {
      "all": [
        {
          "role": "AXWindow",
          "name": "飞书"
        }
      ],
      "none": [
        {
          "role": "AXStaticText",
          "name": "会议中"
        },
        {
          "role": "AXButton",
          "name": "接听"
        },
        {
          "role": "AXButton",
          "name": "离开会议"
        }
      ]
    },
    "connected": [
      {
        "role": "AXStaticText",
        "name": "会议中"
      }
    ],
    "dialing": [
      {
        "role": "AXStaticText",
        "name": "正在连接"
      }
    ]
  },
  "actions": {
    "join": {
      "kind": "group",
      "steps": [
        {
          "kind": "invoke",
          "selector": {
            "role": "AXButton",
            "name": "加入会议",
            "ancestor": {
              "role": "AXWindow",
              "name": "飞书"
            }
          }
        },
        {
          "kind": "setValue",
          "selector": {
            "role": "AXTextField",
            "name": "会议号"
          },
          "value": "{target}"
        },
        {
          "kind": "invoke",
          "selector": {
            "role": "AXButton",
            "name": "加入会议",
            "ancestor": {
              "role": "AXWindow",
              "name": "加入会议"
            }
          },
          "commit": true
        }
      ],
      "target": {
        "role": "AXTextField",
        "name": "会议号",
        "value": "{target}"
      }
    },
    "hangup": {
      "kind": "group",
      "steps": [
        {
          "kind": "invoke",
          "selector": {
            "role": "AXButton",
            "name": "离开会议"
          },
          "commit": true
        }
      ]
    }
  },
  "evidenceMode": "preflight",
  "preflight": [
    {
      "kind": "invoke",
      "selector": {
        "role": "AXButton",
        "name": "设置"
      },
      "waitFor": {
        "role": "AXButton",
        "name": "账号与安全"
      }
    },
    {
      "kind": "invoke",
      "selector": {
        "role": "AXButton",
        "name": "账号与安全"
      },
      "waitFor": {
        "role": "AXStaticText",
        "name": "{self}"
      }
    },
    {
      "kind": "verify",
      "field": "identity"
    },
    {
      "kind": "invoke",
      "selector": {
        "role": "AXButton",
        "name": "音频"
      },
      "waitFor": {
        "role": "AXPopUpButton",
        "name": "{input}"
      }
    },
    {
      "kind": "verify",
      "field": "audioInput"
    },
    {
      "kind": "verify",
      "field": "audioOutput"
    },
    {
      "kind": "invoke",
      "selector": {
        "role": "AXButton",
        "name": "关闭"
      }
    }
  ]
}
