{
  "formatVersion": 1,
  "platform": "wechat",
  "os": "linux",
  "calibrated": false,
  "label": "微信私聊语音",
  "notes": [
    "Calibration required: these are explicit starter workflows, not a declaration that a particular client build was tested.",
    "Preflight opens settings, reads the account and both audio device selections, and closes settings before call control. Edit these settings selectors to the actual accessibility tree; no audio setting is changed automatically.",
    "Exact target identity must be exposed. Do not substitute a non-unique contact nickname for an account ID; inspect the contact detail or meeting ID view and scope selectors appropriately.",
    "Client settings may expose names in title, description or value depending on platform. The inspector reports all three.",
    "While connected, account and routes are bound to the previously checked process/configuration. Manual changes to hidden settings cannot be detected continuously."
  ],
  "identity": {
    "role": "label",
    "name": "{self}"
  },
  "target": {
    "role": "label",
    "name": "{target}"
  },
  "audioInput": {
    "role": "combo box",
    "name": "{input}"
  },
  "audioOutput": {
    "role": "combo box",
    "name": "{output}"
  },
  "states": {
    "idle": {
      "all": [
        {
          "role": "frame",
          "name": "微信"
        }
      ],
      "none": [
        {
          "role": "label",
          "name": "通话中"
        },
        {
          "role": "push button",
          "name": "接听"
        },
        {
          "role": "push button",
          "name": "挂断"
        }
      ]
    },
    "connected": [
      {
        "role": "label",
        "name": "通话中"
      }
    ],
    "ringing": [
      {
        "role": "push button",
        "name": "接听"
      }
    ],
    "dialing": [
      {
        "role": "label",
        "name": "正在呼叫"
      }
    ]
  },
  "actions": {
    "dial": {
      "kind": "direct",
      "steps": [
        {
          "kind": "setValue",
          "selector": {
            "role": "text",
            "name": "搜索"
          },
          "value": "{target}"
        },
        {
          "kind": "invoke",
          "selector": {
            "role": "label",
            "name": "{target}"
          }
        },
        {
          "kind": "invoke",
          "selector": {
            "role": "push button",
            "name": "语音通话"
          },
          "commit": true
        }
      ]
    },
    "accept": {
      "kind": "direct",
      "steps": [
        {
          "kind": "invoke",
          "selector": {
            "role": "push button",
            "name": "接听"
          },
          "commit": true
        }
      ]
    },
    "reject": {
      "kind": "direct",
      "steps": [
        {
          "kind": "invoke",
          "selector": {
            "role": "push button",
            "name": "拒绝"
          },
          "commit": true
        }
      ]
    },
    "hangup": {
      "kind": "direct",
      "steps": [
        {
          "kind": "invoke",
          "selector": {
            "role": "push button",
            "name": "挂断"
          },
          "commit": true
        }
      ]
    }
  },
  "evidenceMode": "preflight",
  "preflight": [
    {
      "kind": "invoke",
      "selector": {
        "role": "push button",
        "name": "设置"
      },
      "waitFor": {
        "role": "push button",
        "name": "账号设置"
      }
    },
    {
      "kind": "invoke",
      "selector": {
        "role": "push button",
        "name": "账号设置"
      },
      "waitFor": {
        "role": "label",
        "name": "{self}"
      }
    },
    {
      "kind": "verify",
      "field": "identity"
    },
    {
      "kind": "invoke",
      "selector": {
        "role": "push button",
        "name": "音视频"
      },
      "waitFor": {
        "role": "combo box",
        "name": "{input}"
      }
    },
    {
      "kind": "verify",
      "field": "audioInput"
    },
    {
      "kind": "verify",
      "field": "audioOutput"
    },
    {
      "kind": "invoke",
      "selector": {
        "role": "push button",
        "name": "关闭"
      }
    }
  ]
}
