{
  "formatVersion": 1,
  "platform": "feishu",
  "os": "linux",
  "calibrated": false,
  "label": "飞书会议语音",
  "notes": [
    "Calibration required: these are explicit starter workflows, not a declaration that a particular client build was tested.",
    "Preflight opens settings, reads the account and both audio device selections, and closes settings before call control. Edit these settings selectors to the actual accessibility tree; no audio setting is changed automatically.",
    "Exact target identity must be exposed. Do not substitute a non-unique contact nickname for an account ID; inspect the contact detail or meeting ID view and scope selectors appropriately.",
    "Client settings may expose names in title, description or value depending on platform. The inspector reports all three.",
    "While connected, account and routes are bound to the previously checked process/configuration. Manual changes to hidden settings cannot be detected continuously.",
    "Join button before opening the dialog and final join button are scoped to different windows. Calibrate these exact window titles; meeting IDs may be formatted with spaces by the client and must match its displayed form."
  ],
  "identity": {
    "role": "label",
    "name": "{self}"
  },
  "target": {
    "role": "label",
    "name": "{target}"
  },
  "audioInput": {
    "role": "combo box",
    "name": "{input}"
  },
  "audioOutput": {
    "role": "combo box",
    "name": "{output}"
  },
  "states": {
    "idle": {
      "all": [
        {
          "role": "frame",
          "name": "飞书"
        }
      ],
      "none": [
        {
          "role": "label",
          "name": "会议中"
        },
        {
          "role": "push button",
          "name": "接听"
        },
        {
          "role": "push button",
          "name": "离开会议"
        }
      ]
    },
    "connected": [
      {
        "role": "label",
        "name": "会议中"
      }
    ],
    "dialing": [
      {
        "role": "label",
        "name": "正在连接"
      }
    ]
  },
  "actions": {
    "join": {
      "kind": "group",
      "steps": [
        {
          "kind": "invoke",
          "selector": {
            "role": "push button",
            "name": "加入会议",
            "ancestor": {
              "role": "frame",
              "name": "飞书"
            }
          }
        },
        {
          "kind": "setValue",
          "selector": {
            "role": "text",
            "name": "会议号"
          },
          "value": "{target}"
        },
        {
          "kind": "invoke",
          "selector": {
            "role": "push button",
            "name": "加入会议",
            "ancestor": {
              "role": "frame",
              "name": "加入会议"
            }
          },
          "commit": true
        }
      ],
      "target": {
        "role": "text",
        "name": "会议号",
        "value": "{target}"
      }
    },
    "hangup": {
      "kind": "group",
      "steps": [
        {
          "kind": "invoke",
          "selector": {
            "role": "push button",
            "name": "离开会议"
          },
          "commit": true
        }
      ]
    }
  },
  "evidenceMode": "preflight",
  "preflight": [
    {
      "kind": "invoke",
      "selector": {
        "role": "push button",
        "name": "设置"
      },
      "waitFor": {
        "role": "push button",
        "name": "账号与安全"
      }
    },
    {
      "kind": "invoke",
      "selector": {
        "role": "push button",
        "name": "账号与安全"
      },
      "waitFor": {
        "role": "label",
        "name": "{self}"
      }
    },
    {
      "kind": "verify",
      "field": "identity"
    },
    {
      "kind": "invoke",
      "selector": {
        "role": "push button",
        "name": "音频"
      },
      "waitFor": {
        "role": "combo box",
        "name": "{input}"
      }
    },
    {
      "kind": "verify",
      "field": "audioInput"
    },
    {
      "kind": "verify",
      "field": "audioOutput"
    },
    {
      "kind": "invoke",
      "selector": {
        "role": "push button",
        "name": "关闭"
      }
    }
  ]
}
